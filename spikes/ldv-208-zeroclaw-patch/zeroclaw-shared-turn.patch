+/// Stamp a turn frame with its session, turn and sequence, publish it on the
+/// shared event bus for the other sockets on the session, and buffer it for late
+/// joiners. The caller still writes the returned frame to its own socket.
+fn publish_turn_frame(
+    state: &AppState,
+    conn_id: &str,
+    session_id: &str,
+    turn_id: &str,
+    seq: &mut u64,
+    mut frame: serde_json::Value,
+) -> serde_json::Value {
+    *seq += 1;
+    frame["session_id"] = session_id.into();
+    frame["turn_id"] = turn_id.into();
+    frame["seq"] = (*seq).into();
+    state.event_buffer.push(frame.clone());
+    let mut published = frame.clone();
+    published["origin_conn"] = conn_id.into();
+    let _ = state.event_tx.send(published);
+    frame
+}
+
+/// The frames of the session's newest turn, unless that turn already ended.
+fn current_turn_frames(buffered: &[serde_json::Value], session_id: &str) -> Vec<serde_json::Value> {
+    let turn_frames = buffered
+        .iter()
+        .filter(|f| {
+            f["session_id"].as_str() == Some(session_id)
+                && f["turn_id"].is_string()
+                && f["seq"].is_u64()
+        })
+        .collect::<Vec<_>>();
+    let Some(last) = turn_frames.last() else {
+        return Vec::new();
+    };
+    if matches!(last["type"].as_str(), Some("done" | "aborted")) {
+        return Vec::new();
+    }
+    turn_frames
+        .iter()
+        .filter(|f| f["turn_id"] == last["turn_id"])
+        .map(|f| (**f).clone())
+        .collect()
+}
+
+/// Provisional transcript row so `/messages` reflects a running turn; the
+/// authoritative end-of-turn replace overwrites it.
+fn append_provisional(
+    state: &AppState,
+    session_key: &str,
+    message: zeroclaw_providers::ChatMessage,
+) {
+    if let Some(ref backend) = state.session_backend {
+        let _ = backend.append(session_key, &message);
+    }
+}
+
+/// A shared-bus event as this socket should see it: only this session's, not its
+/// own turn frames (already written directly) and not frames already replayed.
+fn shared_frame_for_socket(
+    mut event: serde_json::Value,
+    session_id: &str,
+    conn_id: &str,
+    replayed_through: &Option<(String, u64)>,
+) -> Option<serde_json::Value> {
+    if !event_matches_session(&event, session_id) || is_observability_telemetry(&event) {
+        return None;
+    }
+    if event["origin_conn"].as_str() == Some(conn_id) {
+        return None;
+    }
+    event.as_object_mut()?.remove("origin_conn");
+    let replayed = replayed_through.as_ref().is_some_and(|(turn, last)| {
+        event["turn_id"].as_str() == Some(turn.as_str())
+            && event["seq"].as_u64().is_some_and(|s| s <= *last)
+    });
+    (!replayed).then_some(event)
+}

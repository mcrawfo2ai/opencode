+/// Await `$fut` (the session permit) while still forwarding shared-bus frames, so
+/// a prompt queued behind another socket's turn does not receive that turn's
+/// frames late and out of order once its own turn ends.
+macro_rules! forward_while_waiting {
+    ($fut:expr, $rx:expr, $sender:expr, $session_id:expr, $conn_id:expr, $replayed:expr) => {{
+        let fut = $fut;
+        tokio::pin!(fut);
+        loop {
+            tokio::select! {
+                // Bus first: the previous turn's last frame is published before it
+                // releases the permit and must not lose the race to the permit.
+                biased;
+                event = $rx.recv() => {
+                    if let Ok(event) = event
+                        && let Some(frame) = shared_frame_for_socket(event, &$session_id, &$conn_id, &$replayed)
+                    {
+                        let _ = $sender.send(Message::Text(frame.to_string().into())).await;
+                    }
+                }
+                out = &mut fut => break out,
+            }
+        }
+    }};
+}
